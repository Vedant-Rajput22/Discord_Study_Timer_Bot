# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: Add your server/guild ID for instant slash command updates during development
DISCORD_GUILD_ID=

# Optional: Text channel ID where the bot will post completed study session recaps
LOG_CHANNEL_ID=

# ==========================================
# WEB ANALYTICS DASHBOARD CONFIGURATION
# ==========================================
PORT=3000
BASE_URL=http://localhost:3000

# ==========================================
# STUDY TRACKING RULES
# ==========================================
# Minimum seconds required for a voice session to be recorded (filters accidental misclicks)
MIN_SESSION_SECONDS=10

# Pause study timer if user is deafened (self-deafened or server-deafened)
# Values: true | false
PAUSE_ON_DEAFEN=false

# Specific Voice Channels to track (comma separated IDs, or leave blank to track all non-AFK voice channels)
TRACKED_CHANNEL_IDS=

# Specific Channel Name keywords (comma separated, e.g.: study,focus,library) or leave blank for all
TRACKED_KEYWORDS=

# ==========================================
# DATABASE PATH
# ==========================================
DATABASE_PATH=./data/studybot.db
